# PostgreSQL connection string (sensitive)
# Supabase: Project Settings -> Database -> Connection string
# If your password contains @, encode it as %40.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT signing secret (sensitive) - use any long random string
JWT_SECRET=replace_with_random_64_char_secret

# Sponsor wallet private key (sensitive)
# This wallet authenticates with UGF and sponsors execution.
# Get TYI: https://universalgasframework.com/faucets
# NEVER commit a real private key.
UGF_SPONSOR_PRIVATE_KEY=0xreplace_with_sponsor_wallet_private_key

# TYI_MOCK_USD token on Base Sepolia (public)
UGF_TOKEN_ADDRESS=0x27DC1C167AeF232bb1e21073304B526726a8727e

# Base Sepolia config (public)
UGF_CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Server config
PORT=3001
FRONTEND_URL=http://localhost:5173
